<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    机器上残留了已卸载 Visual Studio 的回退包目录，会让 ResolvePackageAssets 直接崩掉。
    这里清空回退目录，只保留官方源。
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
