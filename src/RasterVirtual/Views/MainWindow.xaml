<Window x:Class="RasterVirtual.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:RasterVirtual.Infrastructure"
        xmlns:vm="clr-namespace:RasterVirtual.ViewModels"
        Title="Raster Virtual" Height="820" Width="1320"
        MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackdrop}">

    <Window.Resources>
        <inf:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <inf:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 主体 -->
            <RowDefinition Height="Auto"/>   <!-- 日志 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6"
                            Background="{StaticResource BrushAccent}" Margin="0,0,11,0">
                        <TextBlock Text="R" FontSize="15" FontWeight="Bold" Foreground="#1A1206"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Raster Virtual" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="桌面级虚拟机管理器" FontSize="11"
                                   Foreground="{StaticResource BrushTextFaint}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 状态芯片 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushBackdrop}" CornerRadius="12"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            Padding="12,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QemuReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushRunning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding QemuStatus}" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushBackdrop}" CornerRadius="12"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding AccelStatusText}" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreferencesCommand}"
                            ToolTip="首选项">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="首选项" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding AboutCommand}"
                            ToolTip="关于">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 工具栏 ==================== -->
        <Border Grid.Row="1" Background="{StaticResource BrushBackdrop}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="14,8">
            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewVmCommand}"
                        Padding="14,7" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="新建虚拟机" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushBorder}" Margin="0,4,14,4"/>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartCommand}" ToolTip="启动虚拟机">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}"
                                   Foreground="{StaticResource BrushRunning}"/>
                        <TextBlock Text="启动" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}" ToolTip="暂停 / 继续">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="暂停" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShutdownCommand}"
                        ToolTip="发送关机信号，让客户机正常关机">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="关机" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ResetCommand}" ToolTip="强制重启">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="重启" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PowerOffCommand}"
                        ToolTip="强制断电（相当于拔电源）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource IconGlyph}"
                                   Foreground="{StaticResource BrushDanger}"/>
                        <TextBlock Text="断电" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BrushBorder}" Margin="14,4"/>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SettingsCommand}" ToolTip="虚拟机设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="设置" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SnapshotCommand}" ToolTip="快照管理">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="快照" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MountIsoCommand}" ToolTip="挂载光盘映像">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE958;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="挂载 ISO" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ScreenshotCommand}" ToolTip="屏幕截图">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding CloneCommand}" ToolTip="克隆虚拟机">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenFolderCommand}" ToolTip="打开虚拟机目录">
                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </Button>

                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                        ToolTip="删除虚拟机" Padding="11,7" Margin="6,0,0,0"
                        Background="Transparent" BorderBrush="Transparent">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：虚拟机列表 -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,12,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="28,6,8,6"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索虚拟机" Foreground="{StaticResource BrushTextFaint}"
                                   VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0">
                        <ListBox ItemsSource="{Binding Machines}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource VmListItem}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7"
                                                Background="{StaticResource BrushBackdrop}"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                Margin="0,0,11,0">
                                            <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding StateBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}"/>
                                                <TextBlock Text=" · " FontSize="11"
                                                           Foreground="{StaticResource BrushTextFaint}"/>
                                                <TextBlock Text="{Binding SpecText}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextFaint}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                            Padding="14,9">
                        <TextBlock Text="{Binding MachineCountText}" FontSize="11"
                                   Foreground="{StaticResource BrushTextFaint}"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- 右：详情 -->
            <Grid Grid.Column="2">

                <!-- 空状态 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding EmptyStateVisible}">
                    <Border Width="72" Height="72" CornerRadius="16"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="还没有虚拟机" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="点击左上角「新建虚拟机」，挂载一个 ISO 映像即可开始安装系统"
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" Margin="0,8,0,20"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewVmCommand}"
                            HorizontalAlignment="Center" Padding="20,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="创建第一台虚拟机" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 详情内容 -->
                <!-- 注意：Visibility 必须绑定到 MainWindow(MainViewModel) 的 DetailVisible，
                     因此不能在此 ScrollViewer 上设置 DataContext=Selected（否则 Visibility 绑定会解析到
                      Selected 上而失败并回退为 Visible，导致「详情面板」常驻显示，与空状态页重叠）。
                     故把 DataContext=Selected 下放到内部 StackPanel。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20"
                              Visibility="{Binding DetailVisible}">
                    <StackPanel DataContext="{Binding Selected}">

                        <!-- 标题区 -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="11"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    Margin="0,0,16,0">
                                <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{StaticResource BrushSurface}" CornerRadius="10"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            Padding="9,3" Margin="0,0,7,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding StateBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource BrushSurface}" CornerRadius="10"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            Padding="9,3">
                                        <TextBlock Text="{Binding OsText}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 规格卡片 -->
                        <TextBlock Text="硬件配置" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="处理器与内存" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding SpecText}" FontSize="15" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="固件" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding FirmwareText}" FontSize="15" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="加速模式" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding AccelText}" FontSize="15" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="存储与外设" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="虚拟硬盘" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DiskText}" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Style="{StaticResource HLine}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="光盘映像" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IsoText}" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Style="{StaticResource HLine}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="网络" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NetworkText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="运行记录" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="上次启动" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastStartedText}"/>
                                </Grid>
                                <Border Style="{StaticResource HLine}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="累计运行" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RuntimeText}"/>
                                </Grid>
                                <Border Style="{StaticResource HLine}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="存放位置" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Machine.Directory}"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== 日志面板 ==================== -->
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Expander x:Name="LogExpander" IsExpanded="True" Background="Transparent">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Expander">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ToggleButton x:Name="HeaderBtn" Grid.Row="0" Cursor="Hand"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="16,8">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="10" VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="{StaticResource BrushTextMuted}"/>
                                                                <TextBlock Text="运行日志" FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="Body" Grid.Row="1" Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Expander.Style>

                <Grid Height="170">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="LogScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  Margin="16,0,0,12" Background="{StaticResource BrushBackdrop}">
                        <ItemsControl ItemsSource="{Binding LogLines}" Margin="10,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}"
                                               FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="12,0,16,12" VerticalAlignment="Top">
                        <Button Command="{Binding ClearLogCommand}" Padding="12,6" Margin="0,0,0,6">
                            <TextBlock Text="清空" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="4" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding QemuStatus}" FontSize="11"
                               Foreground="{StaticResource BrushTextFaint}"/>
                    <TextBlock Text="  |  " FontSize="11" Foreground="{StaticResource BrushTextFaint}"/>
                    <TextBlock Text="{Binding AccelStatusText}" FontSize="11"
                               Foreground="{StaticResource BrushTextFaint}"/>
                </StackPanel>
                <TextBlock Text="Raster Virtual 1.0" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{StaticResource BrushTextFaint}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
