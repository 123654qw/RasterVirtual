<Window x:Class="RasterVirtual.Views.DiskCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建虚拟磁盘" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackdrop}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Text="新建虚拟磁盘" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="TargetHint" Text="" FontSize="11"
                       Foreground="{StaticResource BrushTextFaint}" Margin="0,5,0,18"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="文件名" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Text="disk-2"/>

            <TextBlock Text="磁盘格式" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <ComboBox x:Name="FormatCombo"/>

            <TextBlock Text="连接总线" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <ComboBox x:Name="BusCombo"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="容量" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="SizeValue" Grid.Column="1" Text="64 GB"
                           HorizontalAlignment="Right" FontSize="12"
                           Foreground="{StaticResource BrushAccent}"/>
            </Grid>
            <Slider x:Name="SizeSlider" Minimum="1" Maximum="512" Value="64"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="SpaceHint" Text="" Style="{StaticResource Hint}"/>

            <CheckBox x:Name="SsdCheck" Content="向客户机上报为固态硬盘（SSD）" IsChecked="True" Margin="0,18,0,0"/>
            <CheckBox x:Name="PreallocCheck" Content="预分配元数据（写入更快，创建稍慢）" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,20,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="OnCancel" MinWidth="88"/>
                    <Button x:Name="CreateButton" Content="创建" Click="OnCreate" MinWidth="88"
                            Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
