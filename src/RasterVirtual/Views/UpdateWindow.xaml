<Window x:Class="RasterVirtual.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本 - Raster Virtual"
        Width="440" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackdrop}"
        Foreground="{StaticResource BrushText}">

    <Border Margin="24" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            CornerRadius="10" Padding="22">
        <StackPanel>
            <TextBlock Text="发现新版本" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccent}" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="当前版本：" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="CurrentVersionRun" Text="-" Style="{StaticResource FieldLabel}"
                           Foreground="{StaticResource BrushText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="最新版本：" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LatestVersionRun" Text="-" Style="{StaticResource FieldLabel}"
                           Foreground="{StaticResource BrushAccent}"/>
            </StackPanel>

            <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="{StaticResource BrushBackdrop}"
                         Foreground="{StaticResource BrushAccent}"/>

            <TextBlock x:Name="StatusText" Text="是否现在更新？" Style="{StaticResource Hint}"
                       Margin="0,10,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="稍后" Width="92" Height="34"
                        Margin="0,0,10,0" Click="LaterButton_Click"
                        Background="{StaticResource BrushBackdrop}"
                        Foreground="{StaticResource BrushText}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"/>
                <Button x:Name="UpdateButton" Content="更新" Width="92" Height="34"
                        Click="UpdateButton_Click"
                        Background="{StaticResource BrushAccent}"
                        Foreground="#14161A" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
