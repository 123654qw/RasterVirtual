<Window x:Class="RasterVirtual.Views.NewVmWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建虚拟机" Height="660" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackdrop}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤指示 -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="StepTitle" Text="基本信息" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="StepSubtitle" Text="给虚拟机起个名字，并选择要安装的操作系统类型"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,5,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Dot1" Style="{StaticResource StepDot}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <Border Width="34" Height="1" Background="{StaticResource BrushBorder}" VerticalAlignment="Center"/>
                    <Border x:Name="Dot2" Style="{StaticResource StepDot}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <Border Width="34" Height="1" Background="{StaticResource BrushBorder}" VerticalAlignment="Center"/>
                    <Border x:Name="Dot3" Style="{StaticResource StepDot}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <Border Width="34" Height="1" Background="{StaticResource BrushBorder}" VerticalAlignment="Center"/>
                    <Border x:Name="Dot4" Style="{StaticResource StepDot}">
                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <Border Width="34" Height="1" Background="{StaticResource BrushBorder}" VerticalAlignment="Center"/>
                    <Border x:Name="Dot5" Style="{StaticResource StepDot}">
                        <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 步骤内容 -->
        <Grid Grid.Row="1" Margin="24,20">

            <!-- ============ 步骤 1：基本信息 ============ -->
            <StackPanel x:Name="Page1">
                <TextBlock Text="虚拟机名称" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Text="新建虚拟机"/>
                <TextBlock Text="名称也会作为虚拟机文件夹名，请避免使用特殊符号。" Style="{StaticResource Hint}"/>

                <TextBlock Text="客户机操作系统" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <ComboBox x:Name="OsCombo"/>
                <TextBlock Text="选择后会自动套用适合该系统的芯片组、固件与虚拟硬件组合。"
                           Style="{StaticResource Hint}"/>

                <TextBlock Text="存放位置" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocationBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Padding="16,7"
                            Click="OnBrowseLocation"/>
                </Grid>
                <TextBlock x:Name="SpaceHint" Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- ============ 步骤 2：处理器与内存 ============ -->
            <StackPanel x:Name="Page2" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="处理器核心数" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="CpuValue" Grid.Column="1" Text="2 核" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}" FontSize="13"/>
                </Grid>
                <Slider x:Name="CpuSlider" Minimum="1" Maximum="16" Value="2"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnCpuChanged"/>
                <TextBlock x:Name="CpuHint" Style="{StaticResource Hint}"/>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="内存大小" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="MemValue" Grid.Column="1" Text="4 GB" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}" FontSize="13"/>
                </Grid>
                <Slider x:Name="MemSlider" Minimum="512" Maximum="32768" Value="4096"
                        IsSnapToTickEnabled="True" TickFrequency="256"
                        ValueChanged="OnMemChanged"/>
                <TextBlock x:Name="MemHint" Style="{StaticResource Hint}"/>

                <TextBlock Text="固件类型" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
                <ComboBox x:Name="FirmwareCombo"/>
                <TextBlock Text="Windows 11 与较新的 Linux 发行版需要 UEFI；Windows 7 及更早系统请选择传统 BIOS。"
                           Style="{StaticResource Hint}"/>

                <TextBlock Text="虚拟化加速" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <ComboBox x:Name="AccelCombo"/>
                <TextBlock x:Name="AccelHint" Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- ============ 步骤 3：虚拟硬盘 ============ -->
            <StackPanel x:Name="Page3" Visibility="Collapsed">
                <RadioButton x:Name="DiskNewRadio" Content="创建一块新的虚拟硬盘" IsChecked="True"
                             GroupName="Disk" Margin="0,0,0,4" Checked="OnDiskModeChanged"/>
                <TextBlock Text="推荐。磁盘文件会随实际使用量动态增长，不会一开始就占满空间。"
                           Style="{StaticResource Hint}" Margin="24,0,0,14"/>

                <Border x:Name="NewDiskPanel" Style="{StaticResource Card}" Margin="24,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="磁盘容量" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DiskValue" Grid.Column="1" Text="64 GB" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" FontSize="13"/>
                        </Grid>
                        <Slider x:Name="DiskSlider" Minimum="8" Maximum="1024" Value="64"
                                IsSnapToTickEnabled="True" TickFrequency="8"
                                ValueChanged="OnDiskSizeChanged"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="磁盘格式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DiskFormatCombo"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="控制器类型" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DiskBusCombo"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <RadioButton x:Name="DiskExistingRadio" Content="使用已有的虚拟硬盘文件"
                             GroupName="Disk" Margin="0,0,0,4" Checked="OnDiskModeChanged"/>
                <Grid x:Name="ExistingDiskPanel" Margin="24,4,0,14" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExistingDiskBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择文件" Margin="8,0,0,0" Padding="14,7"
                            Click="OnBrowseExistingDisk"/>
                </Grid>

                <RadioButton x:Name="DiskNoneRadio" Content="暂不添加硬盘"
                             GroupName="Disk" Checked="OnDiskModeChanged"/>
                <TextBlock Text="适合只想从 ISO 试运行 Live 系统的场景，关机后所有改动都会丢失。"
                           Style="{StaticResource Hint}" Margin="24,0,0,0"/>
            </StackPanel>

            <!-- ============ 步骤 4：安装介质 ============ -->
            <StackPanel x:Name="Page4" Visibility="Collapsed">
                <TextBlock Text="系统安装映像（ISO）" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IsoBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择 ISO" Margin="8,0,0,0" Padding="14,7"
                            Click="OnBrowseIso"/>
                    <Button Grid.Column="2" Content="清除" Margin="6,0,0,0" Padding="14,7"
                            Click="OnClearIso"/>
                </Grid>
                <TextBlock x:Name="IsoInfo" Style="{StaticResource Hint}"/>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="引导顺序" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <CheckBox x:Name="BootFromIsoCheck" Content="优先从光驱引导（首次安装系统时需要勾选）"
                                  IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="BootMenuCheck" Content="开机时显示引导菜单，可手动选择启动设备"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="附加驱动光盘（可选）" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SecondIsoBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择" Margin="8,0,0,0" Padding="16,7"
                            Click="OnBrowseSecondIso"/>
                </Grid>
                <TextBlock Text="若磁盘或网卡选择了 VirtIO，安装 Windows 时需要额外挂载 virtio-win 驱动盘。"
                           Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- ============ 步骤 5：确认 ============ -->
            <Grid x:Name="Page5" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="请确认以下配置，点击「创建虚拟机」后会立即建立磁盘文件。"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="SummaryPanel"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Padding="18,8" Margin="0,0,8,0"
                            Click="OnCancel"/>
                    <Button x:Name="BackButton" Content="上一步" Padding="18,8" Margin="0,0,8,0"
                            IsEnabled="False" Click="OnBack"/>
                    <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}"
                            Content="下一步" Padding="22,8" Click="OnNext"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
