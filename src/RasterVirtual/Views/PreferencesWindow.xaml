<Window x:Class="RasterVirtual.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首选项" Height="600" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackdrop}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="首选项" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="运行时位置、默认存放目录与全局行为"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">

                <TextBlock Text="QEMU 运行时" Style="{StaticResource GroupHeader}"/>

                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RuntimeDot" Grid.Column="0" Width="9" Height="9"
                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{StaticResource BrushTextFaint}"/>
                            <TextBlock x:Name="RuntimeStatus" Grid.Column="1" Text="正在检测……"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RuntimePath" Text="" FontSize="11" Margin="19,7,0,0"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="手动指定 QEMU 目录（留空则自动探测）"
                           Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QemuBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseQemu" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="检测" Click="OnDetectQemu" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="探测顺序：此处指定的目录 → 程序目录下的 runtime\qemu → 系统 PATH → 注册表安装记录。"
                           Style="{StaticResource Hint}"/>

                <Border Style="{StaticResource HLine}" Margin="0,22"/>

                <TextBlock Text="虚拟机存放位置" Style="{StaticResource GroupHeader}"/>

                <TextBlock Text="默认根目录" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RootBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseRoot" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="打开" Click="OnOpenRoot" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="RootHint" Text="" Style="{StaticResource Hint}"/>

                <Border Style="{StaticResource HLine}" Margin="0,22"/>

                <TextBlock Text="硬件加速" Style="{StaticResource GroupHeader}"/>

                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="AccelSummary" Text="" FontSize="13"/>
                        <TextBlock x:Name="AccelAdvice" Text="" FontSize="11" Margin="0,7,0,0"
                                   Foreground="{StaticResource BrushTextFaint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HLine}" Margin="0,22"/>

                <TextBlock Text="行为" Style="{StaticResource GroupHeader}"/>

                <CheckBox x:Name="StopAllCheck" Content="退出程序时自动关闭所有运行中的虚拟机"/>
                <CheckBox x:Name="ShowCmdCheck" Content="在日志中输出完整的 QEMU 命令行" Margin="0,12,0,0"/>

                <Border Style="{StaticResource HLine}" Margin="0,22"/>

                <TextBlock Text="维护" Style="{StaticResource GroupHeader}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="打开配置目录" Click="OnOpenConfig"/>
                    <Button Content="恢复默认设置" Click="OnResetDefaults" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ConfigHint" Text="" Style="{StaticResource Hint}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="OnCancel" MinWidth="88"/>
                    <Button Content="保存" Click="OnSave" MinWidth="88" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
