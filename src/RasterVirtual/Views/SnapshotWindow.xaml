<Window x:Class="RasterVirtual.Views.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快照管理" Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackdrop}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="快照管理" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="StateChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource BrushSurfaceRaised}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="11" Padding="12,5">
                    <TextBlock x:Name="StateChipText" Text="已关闭" FontSize="11.5"/>
                </Border>
            </Grid>
        </Border>

        <!-- 说明 -->
        <Border Grid.Row="1" Background="#1A1D22" Padding="24,12"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="ModeHint" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextMuted}"/>
        </Border>

        <!-- 列表 -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    CornerRadius="6">
                <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Tag}" FontSize="13"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource BrushTextFaint}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="EmptyHint" Text="这台虚拟机还没有任何快照"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextFaint}" FontSize="13"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,14,24,0">
            <Button x:Name="CreateButton" Content="创建快照" Click="OnCreate"
                    Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="RestoreButton" Content="恢复到此快照" Click="OnRestore" Margin="8,0,0,0"/>
            <Button x:Name="RefreshButton" Content="刷新" Click="OnRefresh" Margin="8,0,0,0"/>
            <Button x:Name="DeleteButton" Content="删除" Click="OnDelete" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
        </StackPanel>

        <!-- 底栏 -->
        <Border Grid.Row="4" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,16,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Content="关闭" Click="OnClose" MinWidth="88" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
